// The 'Local Eats & Marts' application aims to boost the visibility of local restaurants and mini markets. It serves as a discovery platform, allowing users to find and explore various businesses in their area, ultimately driving more customers to these establishments.
workspace "Local Business Directory" {
  acceptance = {ai_terms: false}
  preferences = {
    internal_docs    : false
    track_performance: true
    sql_names        : false
    sql_columns      : true
  }
}